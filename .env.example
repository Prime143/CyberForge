# ==============================================================================
# CyberForge Server Configuration & Security Environment Template
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (Relative to project root or absolute path)
DATABASE_PATH=cyberforge.db

# Discord Real-Time Webhook Alerting
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# DevSecOps Access & Governance Secrets (Generate 64-char hex in production)
# Example command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace_with_cryptographically_secure_random_key

# Obscured Lead Portal Slug (Avoid predictable slugs like /admin)
LEAD_PORTAL_ROUTE=/lead-hub
